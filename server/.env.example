# Copy to server/.env
PORT=4000
DATABASE_URL=postgres://foreman:foreman@localhost:5432/foreman
# DATABASE_SSL=true            # set for managed Postgres (Render, Neon, Supabase...)
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
JWT_EXPIRES=8h
CORS_ORIGIN=http://localhost:5173
APP_TZ=Asia/Kolkata            # zone used to decide what "today" and "overdue" mean
